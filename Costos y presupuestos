WITH b AS (
	SELECT 
		CONVERT(date,fecha) as Fecha_Date,
		Hora,
		[ID citacion],
		Paciente,
		[Texto causal modificacion],
		[Unidad organizativa],
		Aseguradora,
		[Creado por],
		([Nombre medico] + ' ' +	[Apellido medico]) as Medico,
		[Sala cita],
		[Fecha creacion] as Fecha_Creacion,
		[Indicador anulacion],
		Prestacion,
		[Causal modificacion],
		ROW_NUMBER() OVER (
			PARTITION BY CONVERT(date,fecha), Hora, Paciente, [ID citacion], [Unidad organizativa]
			ORDER BY Paciente, [Unidad organizativa], fecha, [Indicador anulacion], [Causal modificacion]
		) AS rn
	FROM
		CentroContacto.dbo.Base_Pura_Sap
		where fecha >= '2026-01-01'
		and [Status de prestacion] <> 6
		and [Indicador anulacion] <> 'X'
),
c AS (
    SELECT
        [Unidad organizativa],
        servicio,
        Detalle,
        cola
    FROM
        CentroContacto.dbo.Base_Costos_Presupuestos
),
h AS (
    SELECT 
        [Usuario de Windows/Sap],
        CAST([fecha de Egreso] AS DATE) as Fecha_Egreso
    FROM 
        CentroContacto.dbo.Headcount
)
SELECT 
    b.Fecha_Date,
    b.[Unidad organizativa],
    b.[Texto causal modificacion],
    b.[Creado por],
    b.Prestacion,
    COUNT(b.[ID citacion]) as cantidad,
    c.Detalle,
    CASE
        WHEN
            b.[Unidad organizativa] = 'TCTRASPL' AND (b.Prestacion = 'SINNIVELES' OR b.Prestacion = 'CONNIVELES')
        THEN
            'LABORATORIO'
        ELSE 
            c.servicio
    END AS servicio,
    CASE
        WHEN
            b.[Texto causal modificacion] = 'CONFIRMACIÓN'
        THEN 
            COUNT(b.[ID citacion])
        ELSE 
            0
    END AS Confirmación_llamadas,
    CASE
        WHEN
            b.[Texto causal modificacion] = 'CONF WHATSAPP'
        THEN 
            COUNT(b.[ID citacion])
        ELSE 
            0
    END AS Confirmación_Whatsapp,
    'Centro de contacto' AS Area,
    c.cola
FROM 
    b
LEFT JOIN 
    c ON c.[Unidad organizativa] = b.[Unidad organizativa]
LEFT JOIN 
    h ON h.[Usuario de Windows/Sap] = b.[Creado por]
WHERE
    h.[Usuario de Windows/Sap] IS NOT NULL
and rn=1
and (h.Fecha_Egreso > b.Fecha_Creacion OR h.fecha_Egreso IS NULL)
group BY 
    b.Fecha_Date,
    b.[Unidad organizativa],
    b.[Texto causal modificacion],
    b.[Creado por],
    b.Prestacion,
    c.Detalle,
    c.servicio,
    c.cola
